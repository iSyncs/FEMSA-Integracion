# Copiar a .env. Nunca subir .env a git.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Contraseña de jose.martinez@demo.femsa.test solo con datos en memoria (sin DATA_SOURCE=sql).
# Con Azure SQL las contraseñas viven como hash bcrypt en dbo.[USER].password_hash.
# DEMO_PASSWORD=

# Fuente de datos: "sql" usa la base de abajo; si no se define, la API usa datos de demostración en memoria.
DATA_SOURCE=sql
DB_HOST=<servidor>.database.windows.net
DB_PORT=1433
DB_NAME=<base>
DB_USER=<usuario>
DB_PASSWORD=<contraseña>
# Solo para un SQL Server local con certificado autofirmado (Docker):
# DB_TRUST_CERT=true

# Azure Blob Storage (preferido: identidad administrada + RBAC; connection string sólo para desarrollo/Azurite).
AZURE_STORAGE_ACCOUNT_NAME=<cuenta-storage>
AZURE_STORAGE_CONTAINER=evidencias
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_BLOB_ENDPOINT=https://<cuenta-storage>.blob.core.windows.net

# Secreto aleatorio de 32+ bytes para firmar autorizaciones de carga.
EVIDENCE_TOKEN_SECRET=<secreto-largo-aleatorio>
EVIDENCE_MAX_BYTES=26214400
EVIDENCE_ZIP_MAX_FILES=50
EVIDENCE_ZIP_MAX_UNCOMPRESSED_BYTES=104857600
EVIDENCE_ZIP_MAX_RATIO=100
# En producción debe permanecer true y Defender for Storage debe usar análisis al cargar.
AZURE_DEFENDER_REQUIRED=true

# Inteligencia artificial (FE1S-24). Cualquier proveedor compatible con la API de OpenAI.
# Sprint 2: OpenRouter con datos de demostración. Local: IA_BASE_URL=http://localhost:1234/v1 (LM Studio, sin clave).
IA_BASE_URL=https://openrouter.ai/api/v1
# IA_API_KEY=
IA_MODEL=<id-del-modelo>
# IA_TIMEOUT_MS=60000

# OpenRouter: sólo el backend conoce la llave. Selecciona un modelo compatible con JSON Schema.
OPENROUTER_API_KEY=<llave-openrouter>
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=FEMSA Auditoría IA
OPENROUTER_TIMEOUT_MS=45000
# Reduce el texto de PDFs extensos conservando el inicio y el cierre (aprox. 6 mil tokens de entrada).
OPENROUTER_MAX_DOCUMENT_CHARS=24000
